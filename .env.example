# ==============================================================================
# RESCUEFLOW AI — CONFIGURATION TEMPLATE
# AI-Powered Disaster Message Prioritization & Response Automation
# ==============================================================================

# ----------------- AI Engine (Groq Cloud API) -----------------
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------- Database (MongoDB) -----------------
# Default local instance or MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017
DB_NAME=rescueflow

# ----------------- n8n Orchestrator -----------------
# Base URL where your local or hosted n8n instance is running
N8N_BASE_URL=http://localhost:5678
N8N_INTAKE_WEBHOOK_URL=http://localhost:5678/webhook/emergency-intake
N8N_APPROVAL_WEBHOOK_URL=http://localhost:5678/webhook/approval-decision

# ----------------- Channels (Configured inside n8n) -----------------
# Telegram Bot Token (from @BotFather) for production webhook triggers
TELEGRAM_BOT_TOKEN=

# Gmail / Email credentials should be configured securely via n8n's Credential Store

# ----------------- Deduplication & Intelligence -----------------
SIMILARITY_THRESHOLD=0.75

# ----------------- Demo & Simulation Mode -----------------
# Keep set to true for hackathon evaluation and safety disclaimers
DEMO_MODE=true

# ----------------- Frontend Config -----------------
VITE_API_BASE_URL=http://localhost:8000
