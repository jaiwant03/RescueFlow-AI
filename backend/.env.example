# Database: MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.86qnngi.mongodb.net/rescueflow?retryWrites=true&w=majority
DB_NAME=rescueflow

# AI Inference Engine: Groq Cloud
GROQ_API_KEY=gsk_your_groq_api_key_here
