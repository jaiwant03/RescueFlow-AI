# n8n Orchestrator Webhooks
N8N_BASE_URL=https://your-n8n-service.onrender.com
N8N_INTAKE_WEBHOOK_URL=https://your-n8n-service.onrender.com/webhook/emergency-intake
N8N_APPROVAL_WEBHOOK_URL=https://your-n8n-service.onrender.com/webhook/approval-decision

# Telegram Emergency Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# System Settings
SIMILARITY_THRESHOLD=0.75
DEMO_MODE=false
