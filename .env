# ==============================================================================
# RESCUEFLOW AI — LOCAL RUNTIME ENVIRONMENT
# AI-Powered Disaster Message Prioritization & Response Automation
# ==============================================================================

# AI Engine (Groq Cloud API)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017
DB_NAME=rescueflow

# n8n Orchestrator
N8N_BASE_URL=http://localhost:5678
N8N_INTAKE_WEBHOOK_URL=http://localhost:5678/webhook/emergency-intake
N8N_APPROVAL_WEBHOOK_URL=http://localhost:5678/webhook/approval-decision

# Channels
TELEGRAM_BOT_TOKEN=

# Deduplication & Scoring
SIMILARITY_THRESHOLD=0.75
DEMO_MODE=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000
